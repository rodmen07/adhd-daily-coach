# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (e2e smoke suite, v0.16)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# lighthouse ci (web vitals baseline, v0.18) - raw runs and rendered reports.
# The reports are kept as a workflow artifact instead; see lighthouserc.cjs.
/.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev-agent automation bookkeeping (runtime state, not app code)
agents/dev-agent/backlog.json
agents/dev-agent/state.json
agents/dev-agent/knowledge.json
agents/dev-agent/run_autonomous*.log
agents/dev-agent/__pycache__/
agents/dev-agent/*.tmp.*
# Keep the markdown report committed so users see failed/parked task lists on GitHub.
!agents/dev-agent/REPORT.md
